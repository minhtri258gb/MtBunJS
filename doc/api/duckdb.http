@host=http://localhost:258

###

# @name duckdb-info
GET {{host}}/api/duckdb-info

###

# @name duckdb-run
POST {{host}}/api/duckdb-run
Content-Type: application/json

{
	"database": "application",
	"sql": "CREATE TABLE application (id INTEGER PRIMARY KEY, name VARCHAR, email VARCHAR, created_at TIMESTAMP DEFAULT current_timestamp)"
}

###

# @name duckdb-run
POST {{host}}/api/duckdb-run
Content-Type: application/json

{
	"database": "application",
	"sql": "DROP TABLE application"
}

###

# @name duckdb-run
POST {{host}}/api/duckdb-run
Content-Type: application/json

{
	"database": "application",
	"sql": "INSER users()"
}

###

# @name duckdb-query
POST {{host}}/api/duckdb-query
Content-Type: application/json

{
	"database": "music",
	"sql": "SELECT name,rate,duration,array_to_string(tags,',') tags,decibel,trackbegin,trackend,miss FROM music"
}

###

	# "sql": "SELECT name, rate, duration, to_json(tags) tags,decibel,trackbegin,trackend,miss FROM music"
